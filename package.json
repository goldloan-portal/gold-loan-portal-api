    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix",
    "prettier:check": "prettier --check \"**/*.{js,ts,json,md}\"",
    "prettier:format": "prettier --write \"**/*.{js,ts,json,md}\"",
